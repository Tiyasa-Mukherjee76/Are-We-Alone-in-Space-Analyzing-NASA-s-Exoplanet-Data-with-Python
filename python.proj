   "source": [
    "#TODO: Create an interactive scatter plot using hvplot with planet names on hover\n",
    "df.hvplot.scatter(\n",
    "    x=\"disc_year\",\n",
    "    y=\"pl_rade\",\n",
    "    hover_cols=[\"pl_name\"],\n",
    "    xlabel=\"Discovery Year\",\n",
    "    ylabel=\"Planet Radius (Earth Radii)\",\n",
    "    title=\"Planet Radius vs Discovery Year\",\n",
    "    width=800,\n",
    "    height=500\n",
    ")\n"
   ]
