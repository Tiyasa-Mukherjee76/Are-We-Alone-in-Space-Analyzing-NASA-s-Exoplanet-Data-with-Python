   "source": [
    "#TODO: Create a bar chart of the top discovery methods\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "method_counts = df[\"discoverymethod\"].value_counts().head(10).reset_index()\n",
    "method_counts.columns = [\"Discovery Method\", \"Count\"]\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "sns.barplot(\n",
    "    data=method_counts,\n",
    "    x=\"Count\",\n",
    "    y=\"Discovery Method\",\n",
    "    hue=\"Discovery Method\",\n",
    "    palette=\"viridis\",\n",
    "    legend=False\n",
    ")\n",
    "\n",
    "plt.title(\"Top Discovery Methods\")\n",
    "plt.xlabel(\"Number of Planets\")\n",
    "plt.ylabel(\"Discovery Method\")\n",
    "\n",
    "plt.show()"
   ]
  },
