   "source": [
    "#TODO: Create Interactive Plot in plotly.express\n",
    "import plotly.express as px\n",
    "\n",
    "plot_df = df[[\"pl_rade\", \"pl_bmasse\", \"pl_orbper\", \"discoverymethod\", \"pl_name\"]].dropna()\n",
    "\n",
    "fig = px.scatter_3d(\n",
    "    plot_df,\n",
    "    x=\"pl_rade\",\n",
    "    y=\"pl_bmasse\",\n",
    "    z=\"pl_orbper\",\n",
    "    color=\"discoverymethod\",\n",
    "    hover_name=\"pl_name\",\n",
    "    log_x=True,\n",
    "    log_y=True,\n",
    "    log_z=True,\n",
    "    title=\"3D Visualization of Planet Radius, Mass, and Orbital Period\",\n",
    "    labels={\n",
    "        \"pl_rade\": \"Planet Radius (Earth Radii)\",\n",
    "        \"pl_bmasse\": \"Planet Mass (Earth Masses)\",\n",
    "        \"pl_orbper\": \"Orbital Period (Days)\"\n",
    "    }\n",
    ")\n",
    "\n",
    "fig.update_traces(marker=dict(size=4))\n",
    "\n",
    "fig.show()"
   ]
  },
